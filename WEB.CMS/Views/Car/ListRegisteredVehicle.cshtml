@using Entities.ViewModels.Car;
@using Entities.Models;
@{
    Layout = null;
    var AllCode = (List<AllCode>)ViewBag.AllCode;
}
@model List<CartoFactoryModel>
<style>
    .badge {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 600;
        color: #fff;
    }
    .badge-danger { background-color: red; }
    .badge-warning { background-color: orange; }
    .badge-success { background-color: #4BAC4D; }
</style>

<table class="data-table">
    <thead>
        <tr>
            <th class="pin pin-stt">STT</th>
            <th class="pin pin-time">Giờ đăng ký online</th>
            <th class="pin pin-plate">Biển số xe</th>
            <th class="text-left">Tên khách hàng (Trại, đại lý)</th>
            <th>Tên lái xe</th>
            <th>Tải trọng xe (kg)</th>
            <th>Ghi chú</th>
            <th>BV ghi chú</th>
            <th>TT đăng kiểm</th>
            <th>Tình trạng xe</th>
        </tr>
    </thead>
    <tbody id="dataBody-@ViewBag.type">
        @if (Model != null && Model.Count > 0)
        {
            @foreach (var item in Model)
            {
                var timeVal = item.RegisterDateOnline != null
                    ? ((DateTime)item.RegisterDateOnline).ToString("HH:mm dd/MM/yyyy")
                    : "";
                <tr class="CartoFactory_@item.Id" data-queue="@timeVal">
                    <td class="pin pin-stt">@item.RecordNumber</td>
                    <td class="pin pin-time">@timeVal</td>
                    <td class="pin pin-plate"><b>@item.VehicleNumber</b></td>
                    <td class="name-td text-left">@item.CustomerName</td>
                    <td>
                        <div>@item.DriverName</div>
                        <div>@item.PhoneNumber</div>
                    </td>
                    <td>@item.VehicleLoad</td>
                    <td>@item.LicenseNumber</td>
                    <td><textarea class="BV_Note" name="BV_Note">@item.ProtectNotes</textarea></td>
                    <td>
                        @{
                            switch (item.TrangThai)
                            {
                                case 1:
                                    <span class="badge badge-warning">Chưa có</span>
                                    break;
                                case 2:
                                    <span class="badge badge-success">Còn hạn</span>
                                    break;
                                case 3:
                                    <span class="badge badge-warning">Sắp hết hạn</span>
                                    break;
                                case 4:
                                    <span class="badge badge-danger">Hết hạn</span>
                                    break;
                            }
                        }
                    </td>
                    <td>
                        <div class="status-dropdown">
                            <button class="dropdown-toggle" data-options='[
                                @foreach (var allcode in AllCode)
                                {
                                    @:{"text":"@allcode.Description","value":"@allcode.CodeValue"}@(allcode != AllCode.Last() ? "," : "")
                                }
                            ]'>
                                @item.VehicleStatusName
                            </button>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
