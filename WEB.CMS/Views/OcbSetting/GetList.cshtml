@using Entities.ViewModels.ObdConfig
@using WEB.CMS.Controllers
@model List<ObdConfigModel>
@{
    var pageIndex = (int)ViewBag.PageIndex;
    var pageSize = (int)ViewBag.PageSize;
    var totalRow = (int)ViewBag.TotalRow;
    var totalPage = totalRow == 0 ? 1 : (int)Math.Ceiling(totalRow / (double)pageSize);
    var fromRow = totalRow == 0 ? 0 : (pageIndex - 1) * pageSize + 1;
    var toRow = Math.Min(pageIndex * pageSize, totalRow);
    var stt = fromRow;
    var startPage = Math.Max(1, pageIndex - 2);
    var endPage = Math.Min(totalPage, startPage + 4);
    startPage = Math.Max(1, endPage - 4);
}
<div class="obd-table">
    <table class="data-table">
        <thead>
            <tr>
                <th style="width: 50px;">STT</th>
                <th>Delivery (OBD)</th>
                <th>Loading Date</th>
                <th>Version</th>
                <th>Net Weight (kg)</th>
                <th>User Create</th>
                <th>User Update</th>
                <th style="width: 110px;">Thao tác</th>
            </tr>
        </thead>
        <tbody id="obd_tbody">
            @if (Model == null || Model.Count == 0)
            {
                <tr class="obd-empty-row">
                    <td colspan="8">Không có dữ liệu</td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr data-id="@item.ObdId">
                        <td>@stt</td>
                        <td class="fw-600 obd-delivery-cell">
                            <span class="obd-delivery-text">@item.Delivery</span>
                            <input type="text" class="obd-inline-input obd-delivery-input" value="@item.Delivery" maxlength="18" inputmode="numeric" style="display:none;">
                        </td>
                        <td>@item.LoadingDate.ToString("dd/MM/yyyy")</td>
                        <td>@item.Version</td>
                        <td class="text-right">@ObdSettingController.FormatWeight(item.NetWeight)</td>
                        <td>@item.UserCreateName</td>
                        <td title="@(item.UpdateLast.HasValue ? "Cập nhật lúc " + item.UpdateLast.Value.ToString("HH:mm dd/MM/yyyy") : "")">@item.UserUpdateName</td>
                        <td>
                            <span class="obd-actions obd-actions--view">
                                <i class="icon-edit obd-btn-edit" title="Sửa Delivery"></i>
                                <span class="obd-btn-history" title="Lịch sử thao tác">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l3 2"></path></svg>
                                </span>
                            </span>
                            <span class="obd-actions obd-actions--edit" style="display:none;">
                                <button type="button" class="obd-btn obd-btn--primary obd-btn--sm obd-btn-save">Lưu</button>
                                <button type="button" class="obd-btn obd-btn--outline obd-btn--sm obd-btn-cancel">Hủy</button>
                            </span>
                        </td>
                    </tr>
                    stt++;
                }
            }
        </tbody>
    </table>
</div>

<div class="obd-foot">
    <div>Hiển thị @fromRow - @toRow trong tổng số @totalRow.ToString("N0") bản ghi</div>
    <div class="obd-pagination">
        <a href="javascript:;" class="obd-page-link @(pageIndex <= 1 ? "disabled" : "")" data-page="@(pageIndex - 1)" title="Trang trước">
            <svg width="6" height="10" viewBox="0 0 6 10" fill="none"><path d="M5 1L1 5l4 4" stroke="#374151" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
        @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
        {
            <a href="javascript:;" class="obd-page-link @(pageNumber == pageIndex ? "active" : "")" data-page="@pageNumber">@pageNumber</a>
        }
        <a href="javascript:;" class="obd-page-link @(pageIndex >= totalPage ? "disabled" : "")" data-page="@(pageIndex + 1)" title="Trang sau">
            <svg width="6" height="10" viewBox="0 0 6 10" fill="none"><path d="M1 1l4 4-4 4" stroke="#374151" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
    </div>
    <select id="obd_page_size">
        @foreach (var size in new[] { 20, 50, 100 })
        {
            <option value="@size" selected="@(size == pageSize)">@size / trang</option>
        }
    </select>
</div>
