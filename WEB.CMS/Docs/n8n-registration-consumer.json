{
  "nodes": [
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Lấy message đăng ký từ RabbitMQ: content là chuỗi JSON -> parse thành object để gửi API WEB.CMS\nconst out = [];\nfor (const item of $input.all()) {\n  let msg = item.json.content ?? item.json;\n  try {\n    // Có thể bị encode 2 lần (chuỗi trong chuỗi) nên parse tối đa 2 lần\n    if (typeof msg === 'string') msg = JSON.parse(msg);\n    if (typeof msg === 'string') msg = JSON.parse(msg);\n  } catch (e) {\n    // Message hỏng: vẫn gửi đi để API trả 400 -> workflow ack, không lặp vô hạn\n    msg = { MessageId: null, ParseError: e.message, Raw: String(item.json.content) };\n  }\n  out.push({ json: msg });\n}\nreturn out;"
      },
      "name": "format data Registration FrontEnd",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://DOMAIN-CMS-BINH-DUONG/api/registration-queue/receive",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Api-Key", "value": "PhShCD5oSWMt98wbI4WhsCkJZPYknyZ4kt0KAb2tdhk" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 30000
        }
      },
      "name": "CMS insert VehicleInspection",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "ok-or-bad-message",
              "leftValue": "={{ [200, 400].includes($json.statusCode) }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "200 hoặc 400?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 0]
    },
    {
      "parameters": {},
      "name": "Xong - ack message",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [960, -100]
    },
    {
      "parameters": {
        "errorMessage": "={{ 'CMS lỗi ' + $json.statusCode + ': ' + JSON.stringify($json.body) }}"
      },
      "name": "Lỗi tạm thời - không ack",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [960, 100]
    }
  ],
  "connections": {
