      "main": [[{ "node": "CMS insert VehicleInspection", "type": "main", "index": 0 }]]
    },
    "CMS insert VehicleInspection": {
      "main": [[{ "node": "200 hoặc 400?", "type": "main", "index": 0 }]]
    },
